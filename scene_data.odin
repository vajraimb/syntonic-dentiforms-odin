//------------------------------------------------------------------------------
//  scene_data -- what each scene is made of: a mesh, its parent, a position and two rotations.
//
//  Transcribed from the original's SceneData.h. The order of the entries is the order
//  of the original's enums, and the paths follow it.
//------------------------------------------------------------------------------
package main

Scene_Entity_Data :: struct {
	mesh:   Data_Mesh,
	parent: int,     // -1 if root; scene 6 teeth: 0 or 1 (index into the scene's gears_idx)
	pos:    [3]f32,
	rot0:   [3]f32,  // rotation at the start, degrees
	rot1:   [3]f32,  // rotation at the end, degrees
}

Scene_Data :: struct {
	length:   f32, // in frames
	count:    int,
	entities: []Scene_Entity_Data,
}

